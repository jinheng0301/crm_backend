# Backend API; change this if the port is already occupied.
API_PORT=18080
CORS_ORIGINS=http://localhost:15173
GIN_MODE=debug

# Local PostgreSQL exposed by docker-compose.yml
DATABASE_URL=postgres://crm:crm@localhost:15432/crm?sslmode=disable
DB_PORT=15432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# Gemini settings (used by the RAG implementation in the next phase)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RAG_TOP_K=6
RAG_CANDIDATES=8
RAG_MIN_SCORE=0.55
AI_RATE_LIMIT_PER_MIN=20
RAG_CHUNK_CHARS=2800
RAG_OVERLAP_CHARS=350
